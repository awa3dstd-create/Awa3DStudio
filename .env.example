# AWA 3D Studio — Environment variables (TEMPLATE)
# ---------------------------------------------------------
# Copy this file to `.env` (local) or set them as Cloudflare env vars.
# Real secrets live ONLY in Cloudflare Pages env vars, never in this repo.
# Full credentials reference: docs/04-CREDENTIALS.md (NOT included in repo — keep locally)

# ============ Phase 1: Lead capture ============

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Trial mode: only delivers to awa3dstd@gmail.com
RESEND_FROM_EMAIL=AWA 3D Studio <onboarding@resend.dev>
# Production mode (requires domain verification in https://resend.com/domains):
# RESEND_FROM_EMAIL=AWA 3D Studio <noreply@awa3dstudio.com>

# Notion (CRM / leads database)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_LEADS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram (real-time lead alerts)
TELEGRAM_BOT_TOKEN=xxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxxx

# ============ Phase 2: Quotes + follow-ups ============

# Protects /api/quote endpoint (Bearer token)
QUOTE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Protects /api/cron/followup endpoint
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Cloudflare deployment ============

CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL
NEXT_PUBLIC_SITE_URL=https://awa3dstudio.pages.dev
